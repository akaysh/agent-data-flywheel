# Any OpenAI-compatible endpoint: LiteLLM proxy (virtual key), Groq, Gemini, Ollama...
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
AGENT_MODEL=            # small model, so the planted bugs happen naturally
FIXED_AGENT_MODEL=      # stronger model for the "swap the model" fix
SIM_MODEL=              # optional, defaults to AGENT_MODEL
JUDGE_MODEL=            # stronger model
LLM_TEMPERATURE=0       # "none" for reasoning models that reject temperature=0
OFFLINE=0               # 1 = replay cache/ only, never call out
